# Copy to .env and adjust. Docker Compose reads .env automatically.
# The defaults below are for local development only; change the credentials
# before exposing the stack to anyone else (see docs/deployment.md).

# --- MLflow server ----------------------------------------------------------
# Host port for the MLflow UI/API.
MLFLOW_HOST_PORT=8080

# Leave empty to keep MLflow's built-in Host header validation (localhost and
# private IPs on any port). For public DNS names, set the exact patterns:
#   MLFLOW_ALLOWED_HOSTS=mlflow.example.com,mlflow.example.com:*
MLFLOW_ALLOWED_HOSTS=

# Browser origins allowed to call the MLflow API cross-origin, e.g.
#   MLFLOW_CORS_ALLOWED_ORIGINS=https://notebook.example.com
MLFLOW_CORS_ALLOWED_ORIGINS=

# Pin a published image instead of building from this checkout (optional):
# MLFLOW_IMAGE=ghcr.io/davidliyutong/mlflow-docker:3.17.1

# Use an external database instead of the bundled MySQL service (optional):
# MLFLOW_BACKEND_STORE_URI=mysql+pymysql://user:pass@db.example.com:3306/mlflowdb

# Server workers (default: MLflow's 4). Keep at 1 with the default SQLite
# auth database, or point OIDC_USERS_DB_URI at MySQL/PostgreSQL instead.
# MLFLOW_WORKERS=4

# --- OIDC authentication (optional) -----------------------------------------
# The image bundles the mlflow-oidc-auth plugin. Setting OIDC_DISCOVERY_URL
# enables SSO: register a confidential client at your IdP with the redirect
# URI <public MLflow URL>/callback, then fill in the values below.
# See docs/oidc.md for the full guide and production checklist.
# OIDC_DISCOVERY_URL=https://idp.example.com/.well-known/openid-configuration
# OIDC_CLIENT_ID=mlflow
# OIDC_CLIENT_SECRET=change-me
# SECRET_KEY=change-me-too           # signs session cookies; keep it stable
# OIDC_REDIRECT_URI=https://mlflow.example.com/callback   # auto-detected by default
# OIDC_SCOPE=openid,email,profile
# OIDC_USERNAME_FIELD=email,preferred_username
# OIDC_GROUP_NAME=mlflow              # groups allowed to log in
# OIDC_GROUP_NAME_PATTERN=mlflow-*    # optional shell-style patterns
# OIDC_ADMIN_GROUP_NAME=mlflow-admin
# OIDC_USERS_DB_URI=mysql+pymysql://mlflow:mlflow@db:3306/mlflow_auth
# DEFAULT_MLFLOW_PERMISSION=NO_PERMISSIONS   # deny by default
# AUTOMATIC_LOGIN_REDIRECT=true
# TRUSTED_PROXIES=10.0.0.0/8          # required behind a reverse proxy

# --- Database ---------------------------------------------------------------
# mysql:5.7 is the default for backwards compatibility; use mysql:8.0 or later
# on arm64 hosts (the image includes the `cryptography` package for MySQL 8
# auth). Note that an existing 5.7 data volume cannot be opened by MySQL 8.
# MYSQL_IMAGE=mysql:8.0
MYSQL_ROOT_PASSWORD=mlflow
MYSQL_DATABASE=mlflowdb
MYSQL_USER=mlflow
MYSQL_PASSWORD=mlflow

# --- Artifact storage (RustFS) ----------------------------------------------
MLFLOW_S3_BUCKET=mlflow
MLFLOW_S3_ACCESS_KEY=mlflow
MLFLOW_S3_SECRET_KEY=mlflowpassword

# Bind host for the RustFS API (9000) and console (9001).
# 127.0.0.1 keeps them on the local host; set 0.0.0.0 to expose them.
RUSTFS_BIND_HOST=127.0.0.1
RUSTFS_API_PORT=9000
RUSTFS_CONSOLE_PORT=9001
